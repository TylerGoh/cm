# The PostgreSQL container's settings. Copy to /etc/cluster-manager/postgres.env, fill it in, and
# make it readable by root only (chmod 600). Read on the first start only, when the data volume is
# initialised: changing a value later changes nothing in the database.
# Use letters and digits in the passwords: the daemon's DATABASE_URL carries the same password,
# and other characters would need URL-encoding there.

# the daemon's user and database; DATABASE_URL in the daemon's .env must match
POSTGRESQL_USERNAME=cluster_manager
POSTGRESQL_PASSWORD=change_me
POSTGRESQL_DATABASE=cluster_manager

# the postgres superuser's password, for maintenance only
POSTGRESQL_POSTGRES_PASSWORD=change_me_too
