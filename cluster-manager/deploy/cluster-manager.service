[Unit]
Description=Cluster manager daemon
After=network-online.target cluster-manager-postgres.service
Wants=network-online.target cluster-manager-postgres.service

[Service]
WorkingDirectory=/opt/cluster-manager
ExecStart=/opt/cluster-manager/.venv/bin/cm daemon
Restart=always
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
