# The cluster manager daemon's settings. Copy to .env in this folder and fill it in. Every key is
# required and no others are allowed. Durations are seconds. Values below are examples.
# Only `cm daemon` reads this file; the other cm commands don't need it.

PORT=8000
LOG_LEVEL=INFO
# %(asctime)s is UTC
LOG_FORMAT="%(asctime)s %(levelname)s %(name)s: %(message)s"

# the PostgreSQL container (deploy/cluster-manager-postgres.container): the user, password and
# database from /etc/cluster-manager/postgres.env
DATABASE_URL=postgresql+asyncpg://cluster_manager:change_me@127.0.0.1:5432/cluster_manager

# the file server: its address and FILE_SERVER_PORT. The fetch timeout must be longer than the
# file server's FILE_SERVER_UPSTREAM_TIMEOUT.
FILE_SERVER_URL=http://file-server.internal:8080
FILE_SERVER_TIMEOUT=10
FILE_SERVER_FETCH_TIMEOUT=660

# used on the first boot only; the file server must be running then
BOOTSTRAP_VERSION=job_1
BOOTSTRAP_UPSTREAM_URL=https://upstream.internal/jobs/job_1/optimized

NON_RESPONDING_SECONDS=30

# CANARY_DURATION_SECONDS must comfortably exceed an update plus the agent's PERFORMANCE_WINDOW_SECONDS.
# The MAX values are how many canary agents may end that way at the deadline. With
# CANARY_MAX_NOT_CONVERGED=0, any agent not running the new version rejects the canary; a canary
# where no agent converged is always rejected.
CANARY_SIZE=5
CANARY_DURATION_SECONDS=1800
CANARY_MAX_CRASHES=0
CANARY_MAX_VIOLATIONS=1
CANARY_MAX_NOT_CONVERGED=0

# The ACTIVE fleet, judged every tick for as long as a version is ACTIVE, by the canary's rules
# with higher limits: how many agents may be in each bucket. Agents still settling after a change
# (not yet acknowledged, or mid-operation), silent agents and agents stopped on purpose don't
# count. Over a limit for FLEET_BREACH_SECONDS rolls back to the latest STABLE automatically
# (0 = on the first breach). An ACTIVE that came from a rollback is never rolled back.
FLEET_MAX_CRASHES=3
FLEET_MAX_VIOLATIONS=3
FLEET_MAX_NOT_CONVERGED=3
FLEET_BREACH_SECONDS=120

# empty: nothing is sent yet, incidents stay pending
MATTERMOST_WEBHOOK_URL=
MATTERMOST_TIMEOUT=5
