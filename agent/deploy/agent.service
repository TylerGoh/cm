[Unit]
Description=Agent (worker supervisor)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/agent
ExecStart=/opt/agent/.venv/bin/agent
Restart=always
RestartSec=5
# Open connections (5s) + the tick in progress (up to the 5s heartbeat) + the ~20s operation grace.
TimeoutStopSec=40

[Install]
WantedBy=multi-user.target
