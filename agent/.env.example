# The agent's settings. Copy to .env in this folder (next to config.py) and fill it in; on a
# provisioned box Foreman writes it. Every key is required and no others are allowed.
# Values below are examples.

# host identity, set upstream by Foreman; different on every box
IPV4=10.0.12.34
HOSTNAME=worker-sg-07
CLUSTER_NAME=sg-prod
# JSON list, at least one: each inventory push sends one record per interface
INTF='["eth0"]'

# server
PORT=8100
LOG_LEVEL=INFO
# %(asctime)s is UTC
LOG_FORMAT="%(asctime)s %(levelname)s %(name)s: %(message)s"

# stores; their folder must exist
MEMORY_STORE_PATH=/var/lib/agent/memory.json
PROCESS_STORE_PATH=/var/lib/agent/process.json

# worker process: the command is a JSON list, binary first, then each flag as its own item
WORKER_COMMAND='[
  "/opt/worker/bin/worker",
  "--flag-a",
  "--flag-b=value"
]'
WORKER_CONSOLE_LOG_DIR=/tmp
WORKER_PROGRAM_LOG_PATH=/var/log/worker/worker.log
WORKER_INITIALIZE_FLAG="ready"
START_TIMEOUT=300
STOP_TIMEOUT=30

# worker HTTP. WORKER_URL is a prefix: each command (show_version, counters, ...) is appended to it
# as-is, with no slash added, so it ends where the command name goes.
WORKER_URL="http://127.0.0.1:9000/api?command="
WORKER_TIMEOUT=2
RELOAD_TIMEOUT=300

# artifacts and hypertrees. BUNDLE_SYMLINK_MAPPING maps a file inside a bundle to the file path
# under ETC_DIR where a symlink to it goes. Only links are created, replaced or removed; a real file
# at a target is refused.
DOWNLOAD_DIR=/srv/agent/downloads
BUNDLE_DIR=/srv/agent/update_bundle
ETC_DIR=/srv/worker/etc
BUNDLE_SYMLINK_MAPPING='{
  "vision/model.bin": "vision/model.bin",
  "spam/rules.txt": "routers/spam/rules.txt"
}'
# every other file in a bundle is linked at ETC_DIR/BUNDLE_SYMLINK_DEFAULT_DIR/<its name>,
# flattened (two with the same name fail the update). Empty: other files aren't linked.
# Every download removes every other symlink under ETC_DIR, wherever it points, so ETC_DIR holds
# exactly the current bundle's links. Real files and folders are never touched.
BUNDLE_SYMLINK_DEFAULT_DIR=defaults
DOWNLOAD_TIMEOUT=600
HYPERTREE_DIR=/srv/worker/hypertree
HYPERTREE_TIMEOUT=300
VERIFY_TIMEOUT=120
VERIFY_INTERVAL=2

# monitors and exporter
HEALTH_INTERVAL=10
MAX_FAILURES=6
PERFORMANCE_INTERVAL=30
PERFORMANCE_WINDOW_SECONDS=300
MAX_METRICS_FAILURES=3
INVENTORY_INTERVAL=60
REQUIRE_RUNNING=false
# one document of the worker's metrics to ELASTIC_METRICS_INDEX, while the worker is RUNNING
METRICS_EXPORT_INTERVAL=30

# cluster manager: the daemon's address and PORT
CLUSTER_MANAGER_URL=http://cluster-manager.internal:8000
# seconds between heartbeat ticks (observe, send the heartbeat, decide, act). The daemon's
# NON_RESPONDING_SECONDS must be several of these.
HEARTBEAT_INTERVAL=10

# elastic; the agent won't start without the CA certificate
ELASTIC_URL=https://elastic.internal:9200
ELASTIC_CERT_PATH=/etc/agent/elastic.cert
# the "encoded" value Elastic returns when the key is created (base64 of id:key), sent as
# "Authorization: ApiKey <value>"; keep the real .env readable only by the agent's user
ELASTIC_API_KEY=VnVhQ2ZHY0JDZGJrUW0tZTVhT3g6dWkybHAyYXhUTm1zeWFrdzl0dk5udw==
ELASTIC_METRICS_INDEX=agent-metrics
ELASTIC_HOST_INDEX=agent-hosts
ELASTIC_TIMEOUT=2

# sent with every host index record; prepare.py writes these from config.yaml's inventory env: fields
# BEGIN generated: inventory settings
# END generated: inventory settings
