# The agent's settings. Copy to .env in this folder (next to config.py) and fill it in; on a
# provisioned box Foreman writes it. Every key is required and no others are allowed.
# Values below are examples.

# host identity, set upstream by Foreman; different on every box
IPV4=10.0.12.34
HOSTNAME=worker-sg-07
LOCATION=sg1

# server
PORT=8100
LOG_LEVEL=INFO
LOG_FORMAT="%(levelname)s %(name)s: %(message)s"

# stores; their folder must exist
MEMORY_STORE_PATH=/var/lib/agent/memory.json
PROCESS_STORE_PATH=/var/lib/agent/process.json

# worker process: the command is a JSON list, binary first, then each flag as its own item
WORKER_COMMAND='[
  "/opt/worker/bin/worker",
  "--flag-a",
  "--flag-b=value"
]'
WORKER_CONSOLE_LOG_DIR=/tmp
WORKER_PROGRAM_LOG_PATH=/var/log/worker/worker.log
WORKER_INITIALIZE_FLAG="ready"
START_TIMEOUT=300
STOP_TIMEOUT=30

# worker HTTP
WORKER_URL=http://127.0.0.1:9000
WORKER_TIMEOUT=2
RELOAD_TIMEOUT=300

# artifacts and hypertrees. BUNDLE_LINKS maps a file inside a bundle to the file path under ETC_DIR
# where a symlink to it goes. Only links are created or replaced; a real file at a target is refused.
DOWNLOAD_DIR=/srv/agent/downloads
BUNDLE_DIR=/srv/agent/update_bundle
ETC_DIR=/srv/worker/etc
BUNDLE_LINKS='{
  "vision/model.bin": "vision/model.bin",
  "spam/rules.txt": "routers/spam/rules.txt"
}'
DOWNLOAD_TIMEOUT=600
HYPERTREE_DIR=/srv/worker/hypertree
HYPERTREE_TIMEOUT=300
VERIFY_TIMEOUT=120
VERIFY_INTERVAL=2

# monitors and exporter
HEALTH_INTERVAL=10
MAX_FAILURES=6
PERFORMANCE_INTERVAL=30
PERFORMANCE_WINDOW_SECONDS=300
MAX_FAILED_RATIO=0.30
MAX_METRICS_FAILURES=3
INVENTORY_INTERVAL=60
REQUIRE_RUNNING=false

# cluster manager: the daemon's address and PORT
CLUSTER_MANAGER_URL=http://cluster-manager.internal:8000

# elastic; the agent won't start without the CA certificate
ELASTIC_URL=https://elastic.internal:9200
ELASTIC_CERT_PATH=/etc/agent/elastic.cert
ELASTIC_METRICS_INDEX=agent-metrics
ELASTIC_HOST_INDEX=agent-hosts
ELASTIC_TIMEOUT=2
