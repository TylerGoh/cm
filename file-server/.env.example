# The file server's settings. Copy to .env in this folder and fill it in. Every key is required
# and no others are allowed. Values below are examples.

# where jobs are stored: <root>/<job_id>/{artifact,job.json,hypertree}. Nothing is ever deleted.
FILE_SERVER_ROOT=/srv/files

# seconds to fetch one artifact from upstream; the daemon's FILE_SERVER_FETCH_TIMEOUT must be longer
FILE_SERVER_UPSTREAM_TIMEOUT=600

# the port it listens on (all interfaces); the daemon's FILE_SERVER_URL points at it
FILE_SERVER_PORT=8080
